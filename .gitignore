# ============ Python (desktop) ============

# Claude Code internal state
.superpowers/
.claude/
.scripts/

# Mnemon 记忆插件运行时数据（本地状态，不入库）
.mnemon/

# Bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Test cache
.pytest_cache/

# Virtual env
.venv/
venv/
env/
ENV/

# Environment & secrets
.env
.env.*
settings.json
.claude/settings.local.json

# Build artifacts
dist/
build/
*.egg-info/
*.egg
*.spec
# PyInstaller 打包配置：桌面完整档 / 便携版（无 GUI）
# 注意：gitignore **不支持行尾注释** —— "!build.spec  # 说明" 会被整体当成
# 模式，等于没写。注释必须单独成行。
!build.spec
!build_web.spec

# Thumbnail cache
.thumbnails/

# Runtime data & test artifacts
desktop/data/
data/

# Docs (managed separately)
docs/

# Logs
*.log

# IDE
.idea/
.vs/
*.swp
*.swo

# OS
Thumbs.db
.DS_Store
$RECYCLE.BIN/

# dsh-ops 运行时锁文件（插件自动生成，非项目文件）
.dsh-ops-update-*.lock
