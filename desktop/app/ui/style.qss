/* ============================================================
   影视资源管理器 — 现代化样式表 v2
   Catppuccin Mocha 配色，经优化的现代设计风格
   树视图分支指示器由程序化绘制（三角形 ▼▶）
   ============================================================ */

/* ---- 全局 ---- */
QMainWindow {
    background-color: #1e1e2e;
    color: #cdd6f4;
}
QWidget {
    background-color: #1e1e2e;
    color: #cdd6f4;
    font-family: "Segoe UI", "Microsoft YaHei", sans-serif;
    font-size: 13px;
}

/* ---- 菜单栏 ---- */
QMenuBar {
    background-color: #181825;
    color: #cdd6f4;
    border-bottom: 1px solid #313244;
    padding: 2px 0;
}
QMenuBar::item {
    padding: 6px 14px;
    border-radius: 4px;
    margin: 1px 2px;
}
QMenuBar::item:selected {
    background-color: #313244;
}
QMenu {
    background-color: #1e1e2e;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 8px;
    padding: 4px;
}
QMenu::item {
    padding: 6px 32px 6px 16px;
    border-radius: 4px;
}
QMenu::item:selected {
    background-color: #313244;
}
QMenu::separator {
    height: 1px;
    background-color: #45475a;
    margin: 4px 12px;
}

/* ---- 工具栏按钮 ---- */
QToolBar {
    background-color: #181825;
    border: none;
    border-bottom: 1px solid #252538;
    padding: 6px 10px;
    spacing: 8px;
}
QToolBar QPushButton {
    background-color: #252538;
    color: #cdd6f4;
    border: none;
    border-radius: 6px;
    padding: 5px 12px;
    font-size: 12px;
    font-weight: 500;
}
QToolBar QPushButton:hover {
    background-color: #313244;
}
QToolBar QPushButton:pressed, QToolBar QPushButton:checked {
    background-color: #45475a;
}

/* ---- 通用按钮 ---- */
QPushButton {
    background-color: #313244;
    color: #cdd6f4;
    border: none;
    border-radius: 6px;
    padding: 7px 16px;
    font-size: 12px;
    font-weight: 500;
}
QPushButton:hover {
    background-color: #45475a;
}
QPushButton:pressed, QPushButton:checked {
    background-color: #585b70;
}
QPushButton:disabled {
    background-color: #252538;
    color: #585b70;
}

/* ---- 选项卡标签（设置对话框等） ---- */
QTabWidget::pane {
    border: 1px solid #313244;
    border-radius: 8px;
    background-color: #1e1e2e;
}
QTabBar::tab {
    background-color: #181825;
    color: #a6adc8;
    border: none;
    border-radius: 6px;
    padding: 8px 18px;
    margin: 4px 2px;
    font-size: 13px;
    font-weight: 500;
}
QTabBar::tab:selected {
    background-color: #313244;
    color: #f0f0f4;
    font-weight: 600;
}
QTabBar::tab:hover:!selected {
    background-color: #252538;
    color: #cdd6f4;
}
QTabBar::tab:disabled {
    color: #585b70;
}

/* ---- 输入框 ---- */
QLineEdit {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 12px;
    selection-background-color: #818cf8;
}
QLineEdit:focus {
    border-color: #818cf8;
}
QComboBox {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 6px;
    padding: 5px 10px;
    font-size: 12px;
}
QComboBox:hover {
    border-color: #818cf8;
}
QComboBox::drop-down {
    border: none;
    width: 20px;
}
QComboBox QAbstractItemView {
    background-color: #1e1e2e;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 6px;
    padding: 4px;
    selection-background-color: #313244;
    outline: none;
}
QComboBox QAbstractItemView::item {
    padding: 4px 8px;
    border-radius: 4px;
}
QComboBox QAbstractItemView::item:hover {
    background-color: #45475a;
}

/* ---- 左侧面板（文件夹树的容器） ---- */
QWidget#leftPanel {
    background-color: #1e1e2e;
    border-right: 1px solid #313244;
}

/* ---- 右侧面板 ---- */
QWidget#rightPanel {
    background-color: #1e1e2e;
}

/* ---- 树视图（左侧面板） ---- */
QTreeView {
    background-color: #1e1e2e;
    color: #cdd6f4;
    border: none;
    outline: none;
    font-size: 13px;
}
QTreeView::item {
    padding: 5px 6px;
    border-radius: 6px;
    margin: 1px 4px;
}
QTreeView::item:selected {
    background-color: #313244;
    color: #cdd6f4;
}
QTreeView::item:selected:active {
    background-color: #363650;
}
QTreeView::item:hover {
    background-color: #252538;
}
/* 分支指示器由 Fusion 样式自动绘制三角形 ▶/▼，不设 QSS 规则以避免覆盖 */

/* 树表头 */
QTreeView QHeaderView {
    background-color: #181825;
    border-bottom: 1px solid #313244;
}
QTreeView QHeaderView::section {
    background-color: #181825;
    color: #a6adc8;
    border: none;
    border-right: 1px solid #252538;
    padding: 6px 10px;
    font-size: 11px;
    font-weight: 600;
}
QTreeView QHeaderView::section:hover {
    color: #cdd6f4;
    background-color: #252538;
}

/* ---- 列表视图（右侧面板缩略图网格） ---- */
QListView {
    background-color: #1e1e2e;
    color: #cdd6f4;
    border: none;
    outline: none;
    padding: 6px;
}
QListView::item {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 4px;
    margin: 1px;
}
QListView::item:selected {
    background-color: rgba(129, 140, 248, 0.12);
}
QListView::item:hover {
    background-color: #252538;
}

/* ---- 分割器 ---- */
QSplitter::handle {
    background-color: #313244;
    width: 1px;
}

/* ---- 滚动条 ---- */
QScrollBar:vertical {
    background-color: transparent;
    width: 8px;
    border-radius: 4px;
}
QScrollBar:vertical:hover {
    background-color: rgba(49, 50, 68, 0.5);
}
QScrollBar::handle:vertical {
    background-color: #45475a;
    border-radius: 4px;
    min-height: 30px;
    margin: 2px;
}
QScrollBar::handle:vertical:hover {
    background-color: #585b70;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar:horizontal {
    background-color: transparent;
    height: 8px;
    border-radius: 4px;
}
QScrollBar:horizontal:hover {
    background-color: rgba(49, 50, 68, 0.5);
}
QScrollBar::handle:horizontal {
    background-color: #45475a;
    border-radius: 4px;
    min-width: 30px;
    margin: 2px;
}
QScrollBar::handle:horizontal:hover {
    background-color: #585b70;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ---- 左侧面板滚动条（更紧凑，贴合左侧面板风格） ---- */
QTreeView QScrollBar:vertical {
    width: 6px;
}
QTreeView QScrollBar:horizontal {
    height: 6px;
}

/* ---- 状态栏 ---- */
QStatusBar {
    background-color: #181825;
    color: #a6adc8;
    border-top: 1px solid #313244;
    font-size: 11px;
    padding: 2px 12px;
    min-height: 22px;
}

/* ---- 消息框 ---- */
QMessageBox {
    background-color: #1e1e2e;
    color: #cdd6f4;
}
QMessageBox QPushButton {
    min-width: 80px;
    min-height: 28px;
}

/* ---- 对话框 ---- */
QDialog {
    background-color: #1e1e2e;
    color: #cdd6f4;
}

/* ---- 标签 ---- */
QLabel {
    background-color: transparent;
    color: #cdd6f4;
}

/* ---- 页头标签 ---- */
QLabel#rightHeader {
    font-weight: 600;
    font-size: 14px;
    padding: 8px 12px;
    color: #cdd6f4;
    border-bottom: 1px solid #313244;
}

/* ---- 面包屑返回按钮 ---- */
QPushButton#breadcrumb {
    background: transparent;
    color: #818cf8;
    border: none;
    font-size: 11px;
    padding: 2px 12px;
    text-align: left;
    font-weight: 500;
}
QPushButton#breadcrumb:hover {
    color: #a6adc8;
}

/* ---- 底部信息标签 ---- */
QLabel#rightFooter {
    color: #a6adc8;
    font-size: 11px;
    padding: 4px 12px;
    border-top: 1px solid #313244;
}

/* ---- 进度条 ---- */
QProgressBar {
    background-color: #313244;
    border: none;
    border-radius: 3px;
    height: 4px;
    text-align: center;
    font-size: 10px;
}
QProgressBar::chunk {
    background-color: #818cf8;
    border-radius: 3px;
}

/* ---- 工具提示 ---- */
QToolTip {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
}
