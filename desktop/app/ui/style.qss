/* ============================================================
   影视资源管理器 — 现代化样式表
   Catppuccin Mocha 配色，支持明暗双模式
   ============================================================ */

/* ---- 全局 ---- */
QMainWindow {
    background-color: #1e1e2e;
    color: #cdd6f4;
}
QWidget {
    background-color: #1e1e2e;
    color: #cdd6f4;
    font-family: "Segoe UI", "Microsoft YaHei", sans-serif;
    font-size: 13px;
}

/* ---- 菜单栏 ---- */
QMenuBar {
    background-color: #181825;
    color: #cdd6f4;
    border-bottom: 1px solid #313244;
    padding: 2px 0;
}
QMenuBar::item {
    padding: 4px 12px;
    border-radius: 4px;
}
QMenuBar::item:selected {
    background-color: #3b3b4e;
}
QMenu {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #3b3b4e;
    border-radius: 6px;
    padding: 4px;
}
QMenu::item {
    padding: 6px 28px 6px 12px;
    border-radius: 4px;
}
QMenu::item:selected {
    background-color: #3b3b4e;
}
QMenu::separator {
    height: 1px;
    background-color: #3b3b4e;
    margin: 3px 8px;
}

/* ---- 工具栏 ---- */
QToolBar {
    background-color: #181825;
    border-bottom: 1px solid #313244;
    padding: 4px 8px;
    spacing: 6px;
}
QPushButton {
    background-color: #313244;
    color: #cdd6f4;
    border: none;
    border-radius: 6px;
    padding: 5px 12px;
    font-size: 12px;
}
QPushButton:hover {
    background-color: #3b3b4e;
}
QPushButton:pressed, QPushButton:checked {
    background-color: #52546a;
}

/* ---- 输入框 ---- */
QLineEdit {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #3b3b4e;
    border-radius: 6px;
    padding: 5px 10px;
    font-size: 12px;
}
QLineEdit:focus {
    border-color: #818cf8;
}
QComboBox {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #3b3b4e;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 12px;
}
QComboBox:hover {
    border-color: #818cf8;
}
QComboBox QAbstractItemView {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #3b3b4e;
    border-radius: 4px;
    selection-background-color: #3b3b4e;
}

/* ---- 树视图（左侧面板） ---- */
QTreeView {
    background-color: #1e1e2e;
    color: #cdd6f4;
    border: none;
    outline: none;
    font-size: 13px;
}
QTreeView::item {
    padding: 5px 4px;
    border-radius: 4px;
}
QTreeView::item:selected {
    background-color: #3b3b4e;
    color: #cdd6f4;
}
QTreeView::item:hover {
    background-color: #313244;
}
QTreeView::branch {
    border-image: none;
    image: none;
}

/* ---- 列表视图（右侧面板） ---- */
QListView {
    background-color: #1e1e2e;
    color: #cdd6f4;
    border: none;
    outline: none;
}
QListView::item {
    background-color: transparent;
    border-radius: 6px;
    padding: 4px;
}
QListView::item:selected {
    background-color: rgba(59, 59, 78, 0.5);
}
QListView::item:hover {
    background-color: #313244;
}

/* ---- 分割器 ---- */
QSplitter::handle {
    background-color: #313244;
    width: 1px;
}

/* ---- 滚动条 ---- */
QScrollBar:vertical {
    background-color: #1e1e2e;
    width: 10px;
    border-radius: 5px;
}
QScrollBar::handle:vertical {
    background-color: #3b3b4e;
    border-radius: 5px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background-color: #52546a;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar:horizontal {
    background-color: #1e1e2e;
    height: 10px;
    border-radius: 5px;
}
QScrollBar::handle:horizontal {
    background-color: #3b3b4e;
    border-radius: 5px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover {
    background-color: #52546a;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ---- 状态栏 ---- */
QStatusBar {
    background-color: #181825;
    color: #a6adc8;
    border-top: 1px solid #313244;
    font-size: 11px;
    padding: 2px 8px;
}

/* ---- 消息框 ---- */
QMessageBox {
    background-color: #1e1e2e;
    color: #cdd6f4;
}
QMessageBox QPushButton {
    min-width: 80px;
}

/* ---- 对话框 ---- */
QDialog {
    background-color: #1e1e2e;
    color: #cdd6f4;
}

/* ---- 标签 ---- */
QLabel {
    background-color: transparent;
    color: #cdd6f4;
}

/* ---- 页头标签 ---- */
QLabel#rightHeader {
    font-weight: bold;
    font-size: 14px;
    padding: 6px 8px;
    color: #818cf8;
}

/* ---- 面包屑返回按钮 ---- */
QPushButton#breadcrumb {
    background: transparent;
    color: #818cf8;
    border: none;
    font-size: 11px;
    padding: 2px 8px;
    text-align: left;
}
QPushButton#breadcrumb:hover {
    color: #cdd6f4;
}

/* ---- 底部信息标签 ---- */
QLabel#rightFooter {
    color: #a6adc8;
    font-size: 11px;
}

/* ---- 进度条 ---- */
QProgressBar {
    background-color: #313244;
    border: none;
    border-radius: 4px;
    height: 6px;
    text-align: center;
    font-size: 10px;
}
QProgressBar::chunk {
    background-color: #818cf8;
    border-radius: 4px;
}
