/* ============================================================
   影视资源管理器 — 现代化样式表 v2
   Slate-Indigo（与 theme.py / Web 端同一套色板） 配色，经优化的现代设计风格
   树视图分支指示器由程序化绘制（三角形 ▼▶）
   ============================================================ */

/* ---- 全局 ---- */
QMainWindow {
    background-color: #0e0e12;
    color: #f0f0f4;
}
QWidget {
    background-color: #0e0e12;
    color: #f0f0f4;
    font-family: "Segoe UI", "Microsoft YaHei", sans-serif;
    font-size: 13px;
}

/* ---- 菜单栏 ---- */
QMenuBar {
    background-color: #16161d;
    color: #f0f0f4;
    border-bottom: 1px solid #252530;
    padding: 2px 0;
}
QMenuBar::item {
    padding: 6px 14px;
    border-radius: 4px;
    margin: 1px 2px;
}
QMenuBar::item:selected {
    background-color: #252530;
}
QMenu {
    background-color: #0e0e12;
    color: #f0f0f4;
    border: 1px solid #363648;
    border-radius: 8px;
    padding: 4px;
}
QMenu::item {
    padding: 6px 32px 6px 16px;
    border-radius: 4px;
}
QMenu::item:selected {
    background-color: #252530;
}
QMenu::separator {
    height: 1px;
    background-color: #363648;
    margin: 4px 12px;
}

/* ---- 工具栏按钮 ---- */
QToolBar {
    background-color: #16161d;
    border: none;
    border-bottom: 1px solid #252530;
    padding: 6px 10px;
    spacing: 8px;
}
QToolBar QPushButton {
    background-color: #252530;
    color: #f0f0f4;
    border: none;
    border-radius: 6px;
    padding: 5px 12px;
    font-size: 12px;
    font-weight: 500;
}
QToolBar QPushButton:hover {
    background-color: #252530;
}
QToolBar QPushButton:pressed, QToolBar QPushButton:checked {
    background-color: #363648;
}

/* ---- 通用按钮 ---- */
QPushButton {
    background-color: #252530;
    color: #f0f0f4;
    border: none;
    border-radius: 6px;
    padding: 7px 16px;
    font-size: 12px;
    font-weight: 500;
}
QPushButton:hover {
    background-color: #363648;
}
QPushButton:pressed, QPushButton:checked {
    background-color: #5e5e72;
}
QPushButton:disabled {
    background-color: #252530;
    color: #5e5e72;
}

/* ---- 选项卡标签（设置对话框等） ---- */
QTabWidget::pane {
    border: 1px solid #252530;
    border-radius: 8px;
    background-color: #0e0e12;
}
QTabBar::tab {
    background-color: #16161d;
    color: #a0a0b0;
    border: none;
    border-radius: 6px;
    padding: 8px 18px;
    margin: 4px 2px;
    font-size: 13px;
    font-weight: 500;
}
QTabBar::tab:selected {
    background-color: #252530;
    color: #f0f0f4;
    font-weight: 600;
}
QTabBar::tab:hover:!selected {
    background-color: #252530;
    color: #f0f0f4;
}
QTabBar::tab:disabled {
    color: #5e5e72;
}

/* ---- 输入框 ---- */
QLineEdit {
    background-color: #252530;
    color: #f0f0f4;
    border: 1px solid #363648;
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 12px;
    selection-background-color: #6366f1;
}
QLineEdit:focus {
    border-color: #6366f1;
}
QComboBox {
    background-color: #252530;
    color: #f0f0f4;
    border: 1px solid #363648;
    border-radius: 6px;
    padding: 5px 10px;
    font-size: 12px;
}
QComboBox:hover {
    border-color: #6366f1;
}
QComboBox::drop-down {
    border: none;
    width: 20px;
}
QComboBox QAbstractItemView {
    background-color: #0e0e12;
    color: #f0f0f4;
    border: 1px solid #363648;
    border-radius: 6px;
    padding: 4px;
    selection-background-color: #252530;
    outline: none;
}
QComboBox QAbstractItemView::item {
    padding: 4px 8px;
    border-radius: 4px;
}
QComboBox QAbstractItemView::item:hover {
    background-color: #363648;
}

/* ---- 左侧面板（文件夹树的容器） ---- */
QWidget#leftPanel {
    background-color: #0e0e12;
    border-right: 1px solid #252530;
}

/* ---- 右侧面板 ---- */
QWidget#rightPanel {
    background-color: #0e0e12;
}

/* ---- 树视图（左侧面板） ---- */
QTreeView {
    background-color: #0e0e12;
    color: #f0f0f4;
    border: none;
    outline: none;
    font-size: 13px;
}
QTreeView::item {
    padding: 5px 6px;
    border-radius: 6px;
    margin: 1px 4px;
}
QTreeView::item:selected {
    background-color: #252530;
    color: #f0f0f4;
}
QTreeView::item:selected:active {
    background-color: #363648;
}
QTreeView::item:hover {
    background-color: #252530;
}
/* 分支指示器由 Fusion 样式自动绘制三角形 ▶/▼，不设 QSS 规则以避免覆盖 */

/* 树表头 */
QTreeView QHeaderView {
    background-color: #16161d;
    border-bottom: 1px solid #252530;
}
QTreeView QHeaderView::section {
    background-color: #16161d;
    color: #a0a0b0;
    border: none;
    border-right: 1px solid #252530;
    padding: 6px 10px;
    font-size: 11px;
    font-weight: 600;
}
QTreeView QHeaderView::section:hover {
    color: #f0f0f4;
    background-color: #252530;
}

/* ---- 列表视图（右侧面板缩略图网格） ---- */
QListView {
    background-color: #0e0e12;
    color: #f0f0f4;
    border: none;
    outline: none;
    padding: 6px;
}
QListView::item {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 4px;
    margin: 1px;
}
QListView::item:selected {
    background-color: rgba(129, 140, 248, 0.12);
}
QListView::item:hover {
    background-color: #252530;
}

/* ---- 分割器 ---- */
QSplitter::handle {
    background-color: #252530;
    width: 1px;
}

/* ---- 滚动条 ---- */
QScrollBar:vertical {
    background-color: transparent;
    width: 8px;
    border-radius: 4px;
}
QScrollBar:vertical:hover {
    background-color: rgba(49, 50, 68, 0.5);
}
QScrollBar::handle:vertical {
    background-color: #363648;
    border-radius: 4px;
    min-height: 30px;
    margin: 2px;
}
QScrollBar::handle:vertical:hover {
    background-color: #5e5e72;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar:horizontal {
    background-color: transparent;
    height: 8px;
    border-radius: 4px;
}
QScrollBar:horizontal:hover {
    background-color: rgba(49, 50, 68, 0.5);
}
QScrollBar::handle:horizontal {
    background-color: #363648;
    border-radius: 4px;
    min-width: 30px;
    margin: 2px;
}
QScrollBar::handle:horizontal:hover {
    background-color: #5e5e72;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ---- 左侧面板滚动条（更紧凑，贴合左侧面板风格） ---- */
QTreeView QScrollBar:vertical {
    width: 6px;
}
QTreeView QScrollBar:horizontal {
    height: 6px;
}

/* ---- 状态栏 ---- */
QStatusBar {
    background-color: #16161d;
    color: #a0a0b0;
    border-top: 1px solid #252530;
    font-size: 11px;
    padding: 2px 12px;
    min-height: 22px;
}

/* ---- 消息框 ---- */
QMessageBox {
    background-color: #0e0e12;
    color: #f0f0f4;
}
QMessageBox QPushButton {
    min-width: 80px;
    min-height: 28px;
}

/* ---- 对话框 ---- */
QDialog {
    background-color: #0e0e12;
    color: #f0f0f4;
}

/* ---- 标签 ---- */
QLabel {
    background-color: transparent;
    color: #f0f0f4;
}

/* ---- 页头标签 ---- */
QLabel#rightHeader {
    font-weight: 600;
    font-size: 14px;
    padding: 8px 12px;
    color: #f0f0f4;
    border-bottom: 1px solid #252530;
}

/* ---- 面包屑返回按钮 ---- */
QPushButton#breadcrumb {
    background: transparent;
    color: #6366f1;
    border: none;
    font-size: 11px;
    padding: 2px 12px;
    text-align: left;
    font-weight: 500;
}
QPushButton#breadcrumb:hover {
    color: #a0a0b0;
}

/* ---- 状态栏取消按钮 ----
   必须覆盖上面通用 QPushButton 的 padding: 7px 16px 与 12px 字号：
   状态栏高度有限，按钮被限高后通用内边距会把"取消"两个字上下压扁。 */
QPushButton#statusBarCancel {
    padding: 1px 8px;
    font-size: 11px;
    border-radius: 4px;
}

/* ---- 底部信息标签 ---- */
QLabel#rightFooter {
    color: #a0a0b0;
    font-size: 11px;
    padding: 4px 12px;
    border-top: 1px solid #252530;
}

/* ---- 进度条 ---- */
QProgressBar {
    background-color: #252530;
    border: none;
    border-radius: 3px;
    height: 4px;
    text-align: center;
    font-size: 10px;
}
QProgressBar::chunk {
    background-color: #6366f1;
    border-radius: 3px;
}

/* ---- 工具提示 ---- */
QToolTip {
    background-color: #252530;
    color: #f0f0f4;
    border: 1px solid #363648;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
}

/* ---- 补充控件：以前未覆盖，会回落到 QPalette 造成两套底色 ---- */
QCheckBox, QRadioButton {
    color: #f0f0f4;
    spacing: 8px;
    background: transparent;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 16px; height: 16px;
    border: 1px solid #45475a;
    border-radius: 3px;
    background: #16161d;
}
QCheckBox::indicator:hover, QRadioButton::indicator:hover { border-color: #6366f1; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background: #6366f1; border-color: #6366f1;
}
QRadioButton::indicator { border-radius: 8px; }

QSpinBox, QDoubleSpinBox, QLineEdit, QPlainTextEdit, QTextEdit {
    background: #16161d;
    color: #f0f0f4;
    border: 1px solid #45475a;
    border-radius: 6px;
    padding: 4px 8px;
    selection-background-color: #6366f1;
    selection-color: #ffffff;
}
QSpinBox:focus, QDoubleSpinBox:focus, QLineEdit:focus,
QPlainTextEdit:focus, QTextEdit:focus { border-color: #6366f1; }
QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    background: #252530; border: none; width: 16px;
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover { background: #252530; }

QSlider::groove:horizontal { height: 4px; background: #252530; border-radius: 2px; }
QSlider::handle:horizontal {
    width: 14px; margin: -5px 0; border-radius: 7px;
    background: #6366f1;
}
QSlider::handle:horizontal:hover { background: #6366f1; }
QSlider::sub-page:horizontal { background: #6366f1; border-radius: 2px; }

QGroupBox {
    border: 1px solid #252530;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 8px;
    color: #f0f0f4;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #a0a0b0;
}

QTableWidget, QTableView, QListWidget, QListView, QTreeWidget, QTreeView {
    background: #16161d;
    alternate-background-color: #1c1c26;
    color: #f0f0f4;
    border: 1px solid #252530;
    border-radius: 6px;
    gridline-color: #252530;
    selection-background-color: #6366f1;
    selection-color: #ffffff;
}
QHeaderView::section {
    background: #252530;
    color: #a0a0b0;
    border: none;
    border-right: 1px solid #252530;
    padding: 6px 8px;
}
QTableCornerButton::section { background: #252530; border: none; }

QDialogButtonBox QPushButton, QDialog QPushButton {
    min-width: 72px;
}
QToolTip {
    background: #252530;
    color: #f0f0f4;
    border: 1px solid #45475a;
    padding: 4px 8px;
}

/* ---- 一级导航 rail ---- */
QFrame#navRail {
    background: #16161d;
    border-right: 1px solid #252530;
}
QLabel#navRailTitle {
    color: #7c7c8a;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    padding: 4px 0 8px 0;
}
QToolButton#navButton {
    color: #a0a0b0;
    background: transparent;
    border: none;
    border-radius: 10px;
    padding: 8px 4px;
    font-size: 12px;
}
QToolButton#navButton:hover {
    background: #1c1c26;
    color: #f0f0f4;
}
QToolButton#navButton:checked {
    background: #252530;
    color: #f0f0f4;
    font-weight: 600;
}

/* ---- 一级页面 / 操作卡片 ---- */
QWidget#sectionPage {
    background: #0e0e12;
}
QLabel#pageTitle {
    color: #f0f0f4;
    font-size: 22px;
    font-weight: 700;
}
QLabel#pageSubtitle {
    color: #a0a0b0;
    font-size: 13px;
    padding-bottom: 6px;
}
QLabel#pageHint {
    color: #7c7c8a;
    font-size: 12px;
}
QPushButton#primaryBtn {
    background: #6366f1;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: 600;
}
QPushButton#primaryBtn:hover { background: #818cf8; }
QCommandLinkButton#navCard {
    text-align: left;
    color: #f0f0f4;
    background: #1c1c26;
    border: 1px solid #252530;
    border-radius: 10px;
    padding: 12px 16px;
    font-size: 13px;
    line-height: 1.5;
}
QCommandLinkButton#navCard:hover {
    border-color: #6366f1;
    background: #252530;
}
QCommandLinkButton#navCard:pressed { background: #313244; }
QListWidget#libraryRoots {
    background: #16161d;
    border: 1px solid #252530;
    border-radius: 10px;
    padding: 6px;
}
QListWidget#libraryRoots::item {
    padding: 10px 12px;
    border-radius: 6px;
    color: #f0f0f4;
}
QListWidget#libraryRoots::item:hover { background: #252530; }
QListWidget#libraryRoots::item:selected { background: #6366f1; color: #ffffff; }
