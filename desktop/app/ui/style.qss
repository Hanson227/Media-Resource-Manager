/* ============================================================
   影视资源管理器 — 「私人放映室」样式表 v3
   石墨黑 + 黄铜。颜色 token 与 theme.py 保持一致：
     BASE #0B0D10 / MANTLE #101317 / SURFACE_0 #15191E
     SURFACE_1 #1B2027 / SURFACE_2 #272E37 / ACCENT #D9A441
   树视图分支指示器由程序化绘制（三角形 ▼▶）
   ============================================================ */

/* ---- 全局 ---- */
QMainWindow, QDialog, QMessageBox {
    background-color: #0B0D10;
    color: #ECE8E1;
}
QWidget {
    color: #ECE8E1;
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
    font-size: 13px;
}
QLabel {
    background: transparent;
}
QWidget#mainShell {
    background-color: #0B0D10;
}

/* ---- 菜单栏 ---- */
QMenuBar {
    background-color: #101317;
    color: #ECE8E1;
    border-bottom: 1px solid #1B2027;
    padding: 2px 4px;
}
QMenuBar::item {
    padding: 6px 12px;
    border-radius: 5px;
    margin: 1px 2px;
    background: transparent;
}
QMenuBar::item:selected {
    background-color: #1B2027;
}
QMenu {
    background-color: #101317;
    color: #ECE8E1;
    border: 1px solid #272E37;
    border-radius: 8px;
    padding: 5px;
}
QMenu::item {
    padding: 7px 30px 7px 14px;
    border-radius: 5px;
}
QMenu::item:selected {
    background-color: #1B2027;
    color: #ECE8E1;
}
QMenu::separator {
    height: 1px;
    background-color: #272E37;
    margin: 5px 10px;
}

/* ---- 工具栏（预览等窗口仍可能使用） ---- */
QToolBar {
    background-color: #101317;
    border: none;
    border-bottom: 1px solid #1B2027;
    padding: 6px 10px;
    spacing: 8px;
}
QToolBar QPushButton {
    background-color: #1B2027;
    color: #ECE8E1;
    border: none;
    border-radius: 6px;
    padding: 5px 12px;
    font-size: 12px;
}

/* ---- 通用按钮 ---- */
QPushButton {
    background-color: #1B2027;
    color: #ECE8E1;
    border: 1px solid #272E37;
    border-radius: 7px;
    padding: 7px 14px;
    font-size: 12px;
    font-weight: 500;
}
QPushButton:hover {
    background-color: #272E37;
    border-color: #5A6470;
}
QPushButton:pressed {
    background-color: #15191E;
}
QPushButton:checked {
    background-color: rgba(217, 164, 65, 0.14);
    border-color: #D9A441;
    color: #D9A441;
}
QPushButton:disabled {
    background-color: #15191E;
    color: #5A6470;
    border-color: #1B2027;
}
QPushButton#primaryBtn {
    background-color: #D9A441;
    color: #0B0D10;
    border: none;
    border-radius: 8px;
    padding: 8px 18px;
    font-weight: 700;
}
QPushButton#primaryBtn:hover {
    background-color: #E8B65E;
}
QPushButton#primaryBtn:pressed {
    background-color: #C08F33;
}

/* 单元页排序胶囊 */
QPushButton#chipBtn {
    background: transparent;
    border: 1px solid #272E37;
    border-radius: 6px;
    padding: 5px 10px;
    color: #8F99A6;
    font-size: 12px;
}
QPushButton#chipBtn:hover {
    border-color: #5A6470;
    color: #ECE8E1;
}
QPushButton#chipBtn:checked {
    background: rgba(217, 164, 65, 0.12);
    border-color: #D9A441;
    color: #D9A441;
}

/* ---- 输入框 ---- */
QLineEdit, QSpinBox, QDoubleSpinBox, QPlainTextEdit, QTextEdit {
    background-color: #15191E;
    color: #ECE8E1;
    border: 1px solid #272E37;
    border-radius: 7px;
    padding: 6px 10px;
    font-size: 12px;
    selection-background-color: #D9A441;
    selection-color: #0B0D10;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QPlainTextEdit:focus, QTextEdit:focus {
    border-color: #D9A441;
}
QLineEdit#unitSearch {
    padding: 6px 30px 6px 10px;
}
QComboBox {
    background-color: #15191E;
    color: #ECE8E1;
    border: 1px solid #272E37;
    border-radius: 7px;
    padding: 5px 10px;
    font-size: 12px;
}
QComboBox:hover {
    border-color: #5A6470;
}
QComboBox:focus {
    border-color: #D9A441;
}
QComboBox::drop-down {
    border: none;
    width: 20px;
}
QComboBox QAbstractItemView {
    background-color: #101317;
    color: #ECE8E1;
    border: 1px solid #272E37;
    border-radius: 6px;
    padding: 4px;
    selection-background-color: #272E37;
    outline: none;
}
QComboBox QAbstractItemView::item {
    padding: 5px 8px;
    border-radius: 4px;
}
QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    background: #1B2027;
    border: none;
    width: 16px;
}

/* ---- 面板 ---- */
QWidget#leftPanel {
    background-color: #0B0D10;
    border-right: 1px solid #1B2027;
}
QWidget#rightPanel {
    background-color: #0B0D10;
}

/* ---- 树视图 ---- */
QTreeView {
    background-color: transparent;
    color: #ECE8E1;
    border: none;
    outline: none;
    font-size: 12px;
}
QTreeView::item {
    padding: 7px 8px;
    border-radius: 6px;
    margin: 1px 4px;
}
QTreeView::item:selected {
    background-color: rgba(217, 164, 65, 0.13);
    color: #ECE8E1;
}
QTreeView::item:selected:active {
    background-color: rgba(217, 164, 65, 0.18);
}
QTreeView::item:hover {
    background-color: #15191E;
}
QTreeView QHeaderView {
    background-color: transparent;
    border-bottom: 1px solid #1B2027;
}
QTreeView QHeaderView::section {
    background-color: transparent;
    color: #5A6470;
    border: none;
    border-right: 1px solid #1B2027;
    padding: 7px 8px;
    font-size: 10px;
    font-weight: 600;
}

/* ---- 缩略图网格 ---- */
QListView {
    background-color: transparent;
    color: #ECE8E1;
    border: none;
    outline: none;
    padding: 4px;
}
QListView::item {
    background-color: transparent;
    border: none;
    padding: 0;
    margin: 0;
}
QListView::item:selected, QListView::item:hover {
    background-color: transparent;
}

/* ---- 分割器 ---- */
QSplitter::handle {
    background-color: #1B2027;
    width: 1px;
}
QSplitter::handle:hover {
    background-color: #D9A441;
}

/* ---- 滚动条 ---- */
QScrollBar:vertical {
    background-color: transparent;
    width: 8px;
    border-radius: 4px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background-color: #272E37;
    border-radius: 4px;
    min-height: 32px;
}
QScrollBar::handle:vertical:hover {
    background-color: #5A6470;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar:horizontal {
    background-color: transparent;
    height: 8px;
    border-radius: 4px;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background-color: #272E37;
    border-radius: 4px;
    min-width: 32px;
}
QScrollBar::handle:horizontal:hover {
    background-color: #5A6470;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ---- 状态栏 ---- */
QStatusBar {
    background-color: #101317;
    color: #8F99A6;
    border-top: 1px solid #1B2027;
    font-size: 11px;
    padding: 2px 12px;
    min-height: 24px;
}
QStatusBar QLabel {
    color: #8F99A6;
}
QStatusBar::item {
    border: none;
}

/* ---- 消息框 / 对话框 ---- */
QMessageBox QPushButton {
    min-width: 80px;
    min-height: 28px;
}
QDialogButtonBox QPushButton {
    min-width: 72px;
}

/* ---- 占位/提示文字 ---- */
QLabel#pageTitle {
    color: #ECE8E1;
    font-size: 26px;
    font-weight: 700;
}
QLabel#pageSubtitle {
    color: #8F99A6;
    font-size: 13px;
}
QLabel#pageHint {
    color: #5A6470;
    font-size: 12px;
}
QLabel#unitTitle {
    color: #ECE8E1;
    font-size: 18px;
    font-weight: 700;
}
QLabel#unitSubtitle {
    color: #8F99A6;
    font-size: 12px;
}
QLabel#rightFooter {
    color: #8F99A6;
    font-size: 11px;
    padding: 6px 2px 0 2px;
    border-top: 1px solid #1B2027;
}

/* ---- 页面滚动容器（非单元页） ---- */
QScrollArea#pageScroll, QWidget#pageHost, QWidget#pageContent,
QWidget#sectionPage {
    background: transparent;
    border: none;
}
QWidget#pageContent {
    background: transparent;
}

/* ---- 一级导航 rail ---- */
QFrame#navRail {
    background-color: #101317;
    border-right: 1px solid #1B2027;
}
QLabel#navBrand {
    color: #ECE8E1;
    font-size: 19px;
    font-weight: 700;
    letter-spacing: 2px;
    padding: 2px 0 0 0;
}
QLabel#navTagline {
    color: #5A6470;
    font-size: 8px;
    letter-spacing: 1.5px;
    padding-top: 1px;
}
QToolButton#navButton {
    color: #8F99A6;
    background: transparent;
    border: none;
    border-left: 2px solid transparent;
    border-radius: 8px;
    padding: 7px 2px;
    font-size: 11px;
}
QToolButton#navButton:hover {
    background-color: #15191E;
    color: #ECE8E1;
}
QToolButton#navButton:checked {
    background-color: rgba(217, 164, 65, 0.12);
    border-left: 2px solid #D9A441;
    color: #D9A441;
    font-weight: 600;
}
QToolButton#railFooterButton {
    color: #8F99A6;
    background: transparent;
    border: 1px solid #1B2027;
    border-radius: 8px;
    padding: 6px 2px;
    font-size: 11px;
}
QToolButton#railFooterButton:hover {
    background-color: #15191E;
    color: #ECE8E1;
    border-color: #272E37;
}

/* ---- 入口卡片 ---- */
QFrame#navCard {
    background-color: #15191E;
    border: 1px solid #1B2027;
    border-radius: 12px;
}
QFrame#navCard:hover {
    background-color: #1B2027;
    border-color: #5A6470;
}
QFrame#navCard:pressed {
    background-color: #101317;
}
QLabel#navCardIcon {
    background-color: rgba(217, 164, 65, 0.10);
    border-radius: 9px;
}
QLabel#navCardTitle {
    color: #ECE8E1;
    font-size: 15px;
    font-weight: 600;
}
QLabel#navCardDesc {
    color: #8F99A6;
    font-size: 12px;
}
QLabel#navCardChevron {
    background: transparent;
}

/* ---- 指标卡（查重统计） ---- */
QFrame#statStrip {
    background: transparent;
}
QFrame#statCard {
    background-color: #101317;
    border: 1px solid #1B2027;
    border-radius: 10px;
}
QLabel#statValue {
    color: #D9A441;
    font-size: 22px;
    font-weight: 600;
}
QLabel#statLabel {
    color: #8F99A6;
    font-size: 11px;
}

/* ---- 空状态 ---- */
QWidget#gridEmpty {
    background: transparent;
}
QLabel#emptyTitle {
    color: #ECE8E1;
    font-size: 16px;
    font-weight: 600;
}
QLabel#emptyHint {
    color: #5A6470;
    font-size: 12px;
    max-width: 360px;
}

/* ---- 媒体库根目录列表 ---- */
QListWidget#libraryRoots {
    background-color: #15191E;
    border: 1px solid #1B2027;
    border-radius: 10px;
    padding: 6px;
    outline: none;
}
QListWidget#libraryRoots::item {
    padding: 8px 12px;
    border-radius: 7px;
    color: #ECE8E1;
    font-size: 12px;
}
QListWidget#libraryRoots::item:hover {
    background-color: #1B2027;
}
QListWidget#libraryRoots::item:selected {
    background-color: rgba(217, 164, 65, 0.14);
    color: #ECE8E1;
}

/* ---- 面包屑返回按钮 ---- */
QPushButton#breadcrumb {
    background: transparent;
    color: #D9A441;
    border: none;
    font-size: 11px;
    padding: 2px 2px;
    text-align: left;
    font-weight: 500;
}
QPushButton#breadcrumb:hover {
    color: #E8B65E;
}

/* ---- 状态栏取消按钮 ---- */
QPushButton#statusBarCancel {
    padding: 1px 8px;
    font-size: 11px;
    border-radius: 4px;
}

/* ---- 选项卡 ---- */
QTabWidget::pane {
    border: 1px solid #1B2027;
    border-radius: 10px;
    background-color: #0B0D10;
    top: -1px;
}
QTabBar::tab {
    background-color: transparent;
    color: #8F99A6;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 9px 16px;
    margin: 2px 2px 0 2px;
    font-size: 12px;
    font-weight: 500;
}
QTabBar::tab:selected {
    color: #ECE8E1;
    border-bottom: 2px solid #D9A441;
}
QTabBar::tab:hover:!selected {
    color: #ECE8E1;
    background-color: #15191E;
}
QTabBar::tab:disabled {
    color: #5A6470;
}

/* ---- 进度条 ---- */
QProgressBar {
    background-color: #1B2027;
    border: none;
    border-radius: 3px;
    height: 5px;
    text-align: center;
    font-size: 10px;
    color: #8F99A6;
}
QProgressBar::chunk {
    background-color: #D9A441;
    border-radius: 3px;
}

/* ---- 工具提示 ---- */
QToolTip {
    background-color: #1B2027;
    color: #ECE8E1;
    border: 1px solid #272E37;
    border-radius: 5px;
    padding: 5px 8px;
    font-size: 12px;
}

/* ---- 补充控件 ---- */
QCheckBox, QRadioButton {
    color: #ECE8E1;
    spacing: 8px;
    background: transparent;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #272E37;
    border-radius: 4px;
    background: #15191E;
}
QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: #5A6470;
}
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background: #D9A441;
    border-color: #D9A441;
}
QRadioButton::indicator {
    border-radius: 8px;
}

QSlider::groove:horizontal {
    height: 4px;
    background: #1B2027;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    width: 14px;
    margin: -5px 0;
    border-radius: 7px;
    background: #D9A441;
}
QSlider::sub-page:horizontal {
    background: #D9A441;
    border-radius: 2px;
}

QGroupBox {
    border: 1px solid #1B2027;
    border-radius: 10px;
    margin-top: 12px;
    padding-top: 8px;
    color: #ECE8E1;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #8F99A6;
}

QTableWidget, QTableView, QListWidget, QTreeWidget {
    background: #15191E;
    alternate-background-color: #1B2027;
    color: #ECE8E1;
    border: 1px solid #1B2027;
    border-radius: 8px;
    gridline-color: #1B2027;
    selection-background-color: rgba(217, 164, 65, 0.16);
    selection-color: #ECE8E1;
}
QHeaderView::section {
    background: #101317;
    color: #8F99A6;
    border: none;
    border-right: 1px solid #1B2027;
    padding: 7px 8px;
    font-size: 11px;
    font-weight: 600;
}
QTableCornerButton::section {
    background: #101317;
    border: none;
}
