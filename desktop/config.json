{
  "db_path": "data\\media_manager.db",
  "media_extensions": [
    ".3fr",
    ".3gp",
    ".arw",
    ".avi",
    ".bmp",
    ".cr2",
    ".dng",
    ".flv",
    ".gif",
    ".heic",
    ".heif",
    ".jpeg",
    ".jpg",
    ".m4v",
    ".mkv",
    ".mov",
    ".mp4",
    ".mpeg",
    ".mpg",
    ".nef",
    ".orf",
    ".pef",
    ".png",
    ".raf",
    ".rw2",
    ".tif",
    ".tiff",
    ".ts",
    ".webm",
    ".webp",
    ".wmv",
    ".x3f"
  ],
  "exclude_patterns": [
    "$RECYCLE.BIN",
    ".DS_Store",
    ".git",
    ".svn",
    ".thumbnails",
    "System Volume Information",
    "Thumbs.db",
    "__MACOSX"
  ],
  "hash_algorithms": [
    "dhash",
    "md5",
    "phash"
  ],
  "phash_size": 8,
  "dhash_size": 8,
  "video_frame_interval_sec": 5,
  "jaccard_threshold": 0.8,
  "phash_hamming_threshold": 5,
  "dhash_hamming_threshold": 5,
  "face_distance_threshold": 0.6,
  "face_detection_enabled": true,
  "face_model_dir": "models",
  "face_confidence_threshold": 0.7,
  "thumbnail_max_size": 256,
  "thumbnail_cache_subdir": ".thumbnails",
  "thumbnail_cache_dir": "data\\.thumbnails",
  "thumbnail_format": "jpg",
  "thumbnail_quality": 80,
  "window_title": "影视资源管理器",
  "window_width": 1400,
  "window_height": 900,
  "splitter_ratio_left": 30,
  "grid_column_count": 4,
  "grid_spacing": 8,
  "watcher_enabled": true,
  "watcher_debounce_ms": 2000,
  "api_enabled": true,
  "api_host": "0.0.0.0",
  "api_port": 19527,
  "web_pin": "5678",
  "preview_seek_percent": 5,
  "smb_share_name_prefix": "Media_"
}